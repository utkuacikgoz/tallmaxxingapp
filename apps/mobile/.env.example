# Public RevenueCat SDK keys are embedded in the app binary. Use the matching app-specific key
# for each platform. Configure production keys in the EAS production environment as well.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Optional overrides. app.config.ts defaults to the linked @utkuacikgoz/tallsoon project.
EAS_OWNER=utkuacikgoz
EAS_PROJECT_ID=830cb434-572b-47bf-a88f-6e909f4141ff

# app.config.ts defaults to production when APP_VARIANT is unset.
APP_VARIANT=development
